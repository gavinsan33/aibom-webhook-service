    for arg in {{ args }}; do
        case "$arg" in
            --img=*) img="${arg#--img=}" ;;
            *) echo "error: unknown argument '$arg' (expected --img=<image>)" >&2; exit 1 ;;
        esac
    done
    docker build -t "$img" .

