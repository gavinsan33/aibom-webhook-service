# Run `just` with no arguments to see this list.
default:
    @just --list

binary_name := "webhook-server"
# The only place aibom-webhook's namespace is configured — the chart itself has no
# separate namespace value, it always installs into the release namespace passed here.
# Override with `just --set webhook_namespace <ns> <recipe>` if it's ever not project-aibom.
webhook_namespace := "project-aibom"
# quay.io org/user that deploy/deploy-local/chart-push push to and pull from by default.
# Override per-invocation with --repo=<repo>, or with `just --set default_repo <repo> <recipe>`.
default_repo := "quay.io/gsanders"

# --- Build & test ------------------------------------------------------------

[group('build')]
build:
    go build -v -o bin/{{ binary_name }} ./cmd/webhook/

# target: all (default), go, or python — run just one suite with `just test go`/`just test python`.
[group('build')]
test target="all":
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{ target }}" in
        all) {{ just_executable() }} _test-go && {{ just_executable() }} _test-python ;;
        go) {{ just_executable() }} _test-go ;;
        python) {{ just_executable() }} _test-python ;;
        *) echo "unknown test target '{{ target }}' (expected all, go, or python)" >&2; exit 1 ;;
    esac

_test-go:
    go test ./internal/... -v -count=1

_test-python:
    python3 -m venv .venv-test
    .venv-test/bin/pip install -q -r requirements-dev.txt
    .venv-test/bin/python -m pytest

[group('build')]
fmt:
    go fmt ./...

[group('build')]
vet:
    go vet ./...

# Run the webhook locally against certs/ generated by scripts/generate-certs.sh
[group('build')]
run: build
    ./bin/{{ binary_name }} --tls-cert=certs/tls.crt --tls-key=certs/tls.key --port=8443

[group('build')]
clean:
    rm -rf bin/ certs/ .venv-test/

